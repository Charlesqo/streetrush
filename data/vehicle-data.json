    "importantRuntimeNotes": [
      "config.speed is a garage display number and is not a physics speed limiter.",
      "config.power is currently not consumed by VehicleSystem; config.torque is.",
      "trackWidth and wheelRadius are single game scalars, while real vehicles can have different front and rear values.",
      "The 60-second peak is a repeatable simulation measurement, not a measured terminal velocity."
    ]
  },
  "sourceGrades": {
    "A": "Manufacturer technical sheet for the exact model/version.",
    "B": "Manufacturer press, history, or product page that identifies the model but is not a complete homologation sheet.",
